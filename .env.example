# Copy to .env and replace placeholder values before running Docker or Python scripts.
POSTGRES_HOST=localhost
POSTGRES_DB=baomatdulieu
POSTGRES_USER=admin
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_PORT=5432
SECRET_KEY=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_BYTES

# Dedicated database for the local Demo UI and interactive Controlled RAG.
DEMO_DB_NAME=baomatdulieu_demo
# Optional Demo connection overrides (otherwise POSTGRES_* credentials/host/port are reused).
# DEMO_DB_HOST=localhost
# DEMO_DB_PORT=5432
# DEMO_DB_USER=admin
# DEMO_DB_PASSWORD=CHANGE_ME

# Optional benchmark connection overrides. If omitted, benchmark scripts reuse POSTGRES_*.
BENCHMARK_DB_NAME=baomatdulieu_benchmark
# BENCHMARK_DB_HOST=localhost
# BENCHMARK_DB_PORT=5432
# BENCHMARK_DB_USER=admin
# BENCHMARK_DB_PASSWORD=CHANGE_ME

# Optional maintenance database used to CREATE DATABASE; defaults to postgres.
# PG_MAINTENANCE_DB=postgres

# Optional Ollama configuration.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDINGS_URL=http://localhost:11434/api/embeddings
